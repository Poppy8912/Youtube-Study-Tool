{
    "manifest_version": 3,
    "name": "Real Blocker",
    "version": "1.0",
    "permissions": ["storage"],
    "host_permissions": ["*://*.youtube.com/*"],
    "content_scripts":[
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["content/youtube.js"],
            "run_at": "document_start"
        }
    ]
}

